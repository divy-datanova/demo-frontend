# Copy this file to .env and fill in the values:  cp .env.example .env
#
# Only variables prefixed with VITE_ are exposed to the React app, and they are
# bundled into public JavaScript. Never put secrets here (no Google client
# secret, no JWT secret) - those belong in the backend .env only.

# ---------------- Backend API ----------------
# URL of the "demo back" Express server (PORT in the backend .env)
VITE_API_URL=http://localhost:5000

# Google login is handled entirely by the backend: the Google client ID and
# secret go in the backend .env (demo back/.env), not here.

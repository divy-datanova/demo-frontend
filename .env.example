# Copy this file to .env and fill in the values:  cp .env.example .env
#
# Only variables prefixed with VITE_ are exposed to the React app, and they are
# bundled into public JavaScript. Never put secrets here (no AuthCore client
# secret, no session secret) - those belong in the backend .env only.

# ---------------- Backend API ----------------
# URL of the "demo back" Express server (PORT in the backend .env)
VITE_API_URL=http://localhost:5001

# Sign-in is AuthCore single sign-on, handled entirely by the backend: the AuthCore
# client ID and secret go in the backend .env (demo back/.env), not here.
